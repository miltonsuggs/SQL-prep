-- Approach (2–3 lines in plain English before writing SQL):
--


SELECT
  COUNT(*) FILTER (WHERE device_type = 'laptop') AS laptop_views
  , COUNT(*) FILTER (WHERE device_type = 'phone' OR device_type = 'tablet') AS mobile_views
FROM viewership;

or  

SELECT
   SUM(CASE WHEN device_type = 'laptop' THEN 1 ELSE 0 END) AS laptop_views
   , SUM(CASE WHEN device_type = 'phone' or device_type = 'tablet' THEN 1 ELSE 0 END) AS mobile_views
FROM viewership;
